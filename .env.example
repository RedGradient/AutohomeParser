# Параметры PostgreSQL для production Docker Compose.
POSTGRES_DB=autohome
POSTGRES_USER=autohome
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Физические интерфейсы Linux для локального многопроцессного парсера.
AUTOHOME_INTERFACES=wlp0s20f3,enp0s20f0u1c4i2

# Размер одного пакета записи и время мягкой остановки workers.
DATABASE_BATCH_SIZE=1000
SHUTDOWN_TIMEOUT=120
PARSER_UID=1000
PARSER_GID=1000

# Учётные данные API и параметры подписания JWT.
API_USERNAME=autohome
API_PASSWORD=change_me
API_JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_bytes
# Токен живет 5 дней
API_JWT_TTL_SECONDS=432000
API_PORT=8000

# Celery: ежедневная проверка курсов в 08:00 по московскому времени.
CELERY_BROKER_URL=redis://redis:6379/0
CBR_RATES_UPDATE_HOUR=8
CBR_RATES_UPDATE_MINUTE=0
